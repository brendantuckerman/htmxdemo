{#
/**
 * @file
 * A feed card. It draws in when the batch it belongs to is swapped in.
 *
 * Available variables:
 * - title: The article title.
 * - url: The article URL.
 * - image: The rendered main image.
 * - summary: The rendered, trimmed body.
 */
#}
<article class="htmxdemo-scroll__card">
  {{ image }}
  <h2><a href="{{ url }}">{{ title }}</a></h2>
  {{ summary }}
</article>
