      ]
    ],
    'htmxdemo_postcode_result' => [
      'variables' => [
        'title' => 'Serviced area check',
         'available' => FALSE,
        'postcode' => '',
      ]
    ],
    'htmxdemo_wizard' => [
      'variables' => [

      ]
    ],
    'htmxdemo_shipping_calculator' => [
      'variables' => [
        'total' => NULL,
      ],
    ],
    'htmxdemo_dashboard' => [
      'variables' => [
        'cards' => [],
        'card_type_select' => [],
        'attributes' => NULL,
        'add_attributes' => NULL,
        'grid_attributes' => NULL,
      ],
    ],
    'htmxdemo_dashboard_card' => [
      'variables' => [
        'uuid' => '',
        'label' => '',
        'description' => '',
        'attributes' => NULL,
        'body_attributes' => NULL,
